# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
DEBUG=true
CORS_ALLOW_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://mivo:mivo@db:5432/mivo
DATABASE_URL_SYNC=postgresql+psycopg://mivo:mivo@db:5432/mivo
POSTGRES_USER=mivo
POSTGRES_PASSWORD=mivo
POSTGRES_DB=mivo

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=bXgkuUYS8btCnR64znDi0WPkACjDopgX0zvfbjYCvwE=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mivo-media
R2_PUBLIC_BASE_URL=

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
LLM_REQUEST_TIMEOUT_SECONDS=8.0

# A conversation turn runs two passes: the writer produces the customer-facing
# reply as plain prose, the analyst scores the lead and fills in the JSON.
# Both fall back to OPENROUTER_MODEL when unset. Reply quality — Uzbek fluency
# most of all — is where the cheap/fast model tier is weakest, so this is the
# knob to turn if replies read flat; leave the analyst on the cheap model.
LLM_WRITER_MODEL=
LLM_ANALYST_MODEL=
LLM_WRITER_TEMPERATURE=0.75
LLM_ANALYST_TEMPERATURE=0.0

# Semantic product search. Without this, search can only match words the
# catalog already contains — a customer who describes what they want
# ("qishga issiq narsa kerak") instead of naming it finds nothing.
# OpenRouter has no embeddings endpoint, so this is a separate OpenAI key.
# Leave EMBEDDING_API_KEY empty and search falls back to full-text + trigram;
# nothing breaks, it just can't bridge wording.
# EMBEDDING_DIMENSIONS must match the products.embedding column — changing it
# means a migration and `python backfill_embeddings.py`.
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
SEMANTIC_FUSION_WEIGHT=0.6

META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=replace-with-a-verify-token
META_REDIRECT_URI=http://localhost:8000/integrations/instagram/callback

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-telegram-secret
