# Copy to .env and fill in real values. Never commit .env.
# The API refuses to start with a missing or publicly known secret (see
# app/core/config.py) — generate your own for every value marked REQUIRED.

# APP_ENV=production in prod: stricter checks, no /docs.
APP_ENV=development
# DEBUG=true logs SQL with bound parameters (customer PII). Never in prod.
DEBUG=false
CORS_ALLOW_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# REQUIRED: POSTGRES_PASSWORD (compose won't start without it) — and the same
# password in both URLs below.
DATABASE_URL=postgresql+asyncpg://mivo:CHANGE_ME@db:5432/mivo
DATABASE_URL_SYNC=postgresql+psycopg://mivo:CHANGE_ME@db:5432/mivo
POSTGRES_USER=mivo
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=mivo

# REQUIRED, >= 32 chars:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# REQUIRED:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotation: FERNET_KEY=<new>,<old> then `python rotate_fernet_key.py`, then drop <old>.
FERNET_KEY=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mivo-media
R2_PUBLIC_BASE_URL=

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
LLM_REQUEST_TIMEOUT_SECONDS=30.0
LLM_TURN_DEADLINE_SECONDS=60
LLM_RETRY_AFTER_CAP_SECONDS=5

# A conversation turn runs two passes: the writer produces the customer-facing
# reply as plain prose, the analyst scores the lead and fills in the JSON.
# Both fall back to OPENROUTER_MODEL when unset. Reply quality — Uzbek fluency
# most of all — is where the cheap/fast model tier is weakest, so this is the
# knob to turn if replies read flat; leave the analyst on the cheap model.
LLM_WRITER_MODEL=
LLM_ANALYST_MODEL=
LLM_WRITER_TEMPERATURE=0.75
LLM_ANALYST_TEMPERATURE=0.0

# Spend guards: past these the AI hands the conversation to a human and the
# owner is alerted.
AI_DAILY_COST_LIMIT_USD=5.0
AI_MAX_TURNS_PER_CONVERSATION_PER_HOUR=20

# Tuning (optional; these are the defaults). Reply texts sent to customers are
# edited per business on the dashboard's AI settings page.
REPLY_DEBOUNCE_SECONDS=1.5
REPLY_PART_DELAY_SECONDS=0.9
HISTORY_LIMIT=20
MAX_MULTIMODAL_IMAGES=2
MAX_IMAGE_AGE_HOURS=6
MAX_IMAGES_PER_REPLY=3
VOICE_NOTE_MAX_AGE_MINUTES=60
CLOSING_MAX_WORDS=6
CLOSING_MAX_CHARS=60
FOLLOW_UP_AFTER_MINUTES=30
FOLLOW_UP_WINDOW_HOURS=23
FOLLOW_UP_BATCH=50
PROFILE_RETRY_HOURS=24
WEBHOOK_CONCURRENCY=8
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BACKOFF_SECONDS=[30,60,120,300]
WEBHOOK_LEASE_MINUTES=10
WEBHOOK_ORPHAN_AFTER_SECONDS=60
RESEND_WINDOW_MINUTES=20
CONVERSATION_LOCK_WAIT_SECONDS=120
REFRESH_REUSE_GRACE_SECONDS=30

# Voice notes: openrouter (uses OPENROUTER_API_KEY) | groq | openai (use
# STT_API_KEY) | empty = don't transcribe (voice notes go to the owner).
STT_PROVIDER=openrouter
STT_API_KEY=
STT_MODEL=google/gemini-2.5-flash

# Semantic product search. Without this, search can only match words the
# catalog already contains. OpenRouter has no embeddings endpoint, so this is
# a separate OpenAI key. EMBEDDING_DIMENSIONS must match the products.embedding
# column — changing it means a migration and `python backfill_embeddings.py --all`.
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSIONS=1536
EMBEDDING_QUERY_TIMEOUT_SECONDS=2.0
SEMANTIC_FUSION_WEIGHT=0.6

# Meta. Without META_APP_SECRET every webhook is rejected (signatures can't be
# verified). Both are REQUIRED in production.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_REDIRECT_URI=http://localhost:8000/integrations/instagram/callback

# Telegram. Without TELEGRAM_WEBHOOK_SECRET the Telegram webhook rejects
# everything. Register it with:
#   curl "https://api.telegram.org/bot$TELEGRAM_BOT_TOKEN/setWebhook?url=<api>/webhooks/telegram&secret_token=$TELEGRAM_WEBHOOK_SECRET"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Web push. Empty = push disabled.   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:you@example.com
