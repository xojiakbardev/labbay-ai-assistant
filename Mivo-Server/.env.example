# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
DEBUG=true
CORS_ALLOW_ORIGINS=http://localhost:5173

DATABASE_URL=postgresql+asyncpg://mivo:mivo@db:5432/mivo
DATABASE_URL_SYNC=postgresql+psycopg://mivo:mivo@db:5432/mivo
POSTGRES_USER=mivo
POSTGRES_PASSWORD=mivo
POSTGRES_DB=mivo

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

